# ==============================================================================
# RecoverAI — Environment Variables Specification
# Copy this file to .env before running the project
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="RecoverAI"
API_V1_STR="/api/v1"

# Security & Authentication
SECRET_KEY=replace_this_with_a_64_char_secure_random_hex_key_for_jwt
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=recoverai_user
POSTGRES_PASSWORD=recoverai_password
POSTGRES_DB=recoverai_db
DATABASE_URL=postgresql+asyncpg://recoverai_user:recoverai_password@localhost:5432/recoverai_db

# Cache & Locks (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Razorpay Sandbox Credentials
RAZORPAY_KEY_ID=rzp_test_replaceWithYourKeyId
RAZORPAY_KEY_SECRET=replaceWithYourKeySecret
RAZORPAY_WEBHOOK_SECRET=replaceWithYourWebhookSecret

# Frontend Client
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replaceWithYourKeyId

tell command prompt command to make this folder